worker_processes auto;
pid /tmp/lsp-nginx.pid;
error_log /tmp/lsp-nginx-error.log;

events {
    worker_connections 1024;
}

http {
    access_log /tmp/lsp-nginx-access.log;

    upstream lsp_backends {
        least_conn;
{% for node_ip in lsp_nodes %}
        server {{ node_ip }}:8135;
{% endfor %}
    }

    server {
        listen {{ lsp_balancer_port }};
        server_name localhost;

        location = /health {
            default_type application/json;
            add_header Cache-Control "no-store" always;
            return 200 '{"status":"ok","service":"lsp-load-balancer"}';
        }

        location / {
            proxy_pass http://lsp_backends;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
            proxy_pass_request_headers on;
        }
    }
}
