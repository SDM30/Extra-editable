worker_processes auto;

events {
    worker_connections 2048;
}

http {

    upstream collab_backend {
        ip_hash;   # Sticky sessions — imprescindible para Yjs/Hocuspocus
{% for port in collab_ports %}
        server {{ collab_host }}:{{ port }} max_fails=3 fail_timeout=30s;
{% endfor %}
    }

    map $http_upgrade $connection_upgrade {
        default upgrade;
        ''      close;
    }

    server {
        listen 8083;
        server_name localhost;

        # ── Health check ──
        location = /health {
            default_type application/json;
            add_header Cache-Control "no-store" always;
            return 200 '{"status":"ok","service":"collab-load-balancer"}';
        }

        # ── Token de desarrollo ──
        location = /dev-token {
            proxy_pass http://collab_backend;
            proxy_http_version 1.1;
            proxy_set_header Host              $host;
            proxy_set_header X-Real-IP         $remote_addr;
            proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
            proxy_read_timeout    10s;
            proxy_connect_timeout  5s;
            proxy_next_upstream error timeout invalid_header http_500 http_502 http_503;
        }

        # ── WebSocket de colaboración ──
        # NO se valida el token aquí: Hocuspocus lo envía después del handshake
        # (no en la URL), así que el auth_request rompía la conexión. El propio
        # servicio collab valida el JWT en su hook onAuthenticate (server.js).
        location / {
            proxy_pass http://collab_backend;
            proxy_http_version 1.1;
            proxy_set_header Upgrade    $http_upgrade;
            proxy_set_header Connection $connection_upgrade;
            proxy_set_header Host       $host;
            proxy_set_header X-Real-IP  $remote_addr;
            proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;

            proxy_read_timeout    3600s;
            proxy_send_timeout    3600s;
            proxy_connect_timeout    10s;
            proxy_buffering off;
            proxy_next_upstream error timeout;
        }
    }
}
