# Backend environment variables — generado por Ansible
SECRET_KEY={{ django_secret_key | default('django-prod-key-change-me-in-vault') }}
DEBUG=False
ALLOWED_HOSTS={{ backend_host }},localhost,127.0.0.1

# PostgreSQL (en David — {{ db_host }})
DB_ENGINE={{ db_engine }}
DB_NAME={{ db_name }}
DB_USER={{ db_user }}
DB_PASSWORD={{ db_password }}
DB_HOST={{ db_host }}
DB_PORT={{ db_port }}

# JWT
JWT_SECRET={{ jwt_secret }}

# CORS
CORS_ALLOWED_ORIGINS=http://{{ frontend_host }}:{{ frontend_port }}

# Collab
DEFAULT_MAX_COLLAB_USERS=4
DEFAULT_COLLAB_SESSION_TIMEOUT_SECONDS=60
