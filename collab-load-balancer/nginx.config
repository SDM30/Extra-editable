worker_processes auto;

events {
    worker_connections 2048;
}

http {
    resolver 127.0.0.11 ipv6=off valid=30s;

    # ─────────────────────────────────────────────────────────────────────────
    # Upstream: instancias del servicio de colaboración (Hocuspocus)
    #
    # IMPORTANTE: A diferencia del LSP Load Balancer (que usa round-robin),
    # aquí usamos ip_hash para sticky sessions. Un documento Yjs vive en
    # memoria de UNA instancia; si un cliente rebota a otra instancia pierde
    # el estado de awareness (cursores, presencia) y puede generar conflictos
    # de sincronización.
    #
    # ip_hash garantiza que el mismo cliente siempre llegue a la misma
    # instancia mientras esta esté viva, haciendo que la colaboración sea
    # coherente sin necesidad de un back-end compartido (Redis/Postgres).
    #
    # Para levantar múltiples instancias:
    #   PORT=1234 node src/server.js
    #   PORT=1235 node src/server.js
    #   PORT=1236 node src/server.js
    # ─────────────────────────────────────────────────────────────────────────
    upstream collab_backend {
        ip_hash;   # Sticky sessions — imprescindible para Yjs/Hocuspocus

        # Cuando nginx corre dentro de Docker, 127.0.0.1 apunta al contenedor.
        # Usamos host.docker.internal para alcanzar servicios en el host/WSL
        server host.docker.internal:1234 max_fails=3 fail_timeout=30s;
        server host.docker.internal:1235 max_fails=3 fail_timeout=30s;
        server host.docker.internal:1236 max_fails=3 fail_timeout=30s;
    }

    # ─────────────────────────────────────────────────────────────────────────
    # Mapa para manejar el upgrade de WebSocket
    # ─────────────────────────────────────────────────────────────────────────
    map $http_upgrade $connection_upgrade {
        default upgrade;
        ''      close;
    }

    server {
        listen 8083;
        server_name localhost;

        # ── Health check del propio balanceador ──────────────────────────────
        location = /health {
            default_type application/json;
            add_header Cache-Control "no-store" always;
            return 200 '{"status":"ok","service":"collab-load-balancer"}';
        }

        # ── Endpoint de token de desarrollo (/dev-token) ─────────────────────
        # Necesario para que el frontend pueda pedir tokens JWT al servidor
        # collab cuando no hay autenticación real configurada. Redirige a la
        # primera instancia disponible (sin sticky, es un POST puntual).
        location = /dev-token {
            proxy_pass http://collab_backend;

            proxy_http_version 1.1;
            proxy_set_header Host              $host;
            proxy_set_header X-Real-IP         $remote_addr;
            proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;

            proxy_read_timeout    10s;
            proxy_connect_timeout  5s;

            proxy_next_upstream error timeout invalid_header http_500 http_502 http_503;
        }

        # ── Conexiones WebSocket de colaboración ─────────────────────────────
        # Todo el tráfico restante son handshakes WS de Hocuspocus.
        # proxy_read_timeout alto porque las conexiones WS son long-lived.
        # Subrequest interno para validar token con el backend y obtener
        # identidad (X-Auth-User-Id, X-Auth-Username) que se propaga al
        # upstream collab. El backend expone /api/projects/validate-collab-token/.
        location = /_auth {
            internal;
            proxy_pass http://host.docker.internal:8000/api/projects/validate-collab-token/;
            proxy_pass_request_body off;
            proxy_set_header Content-Length "";
            proxy_set_header Host $host;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
            proxy_set_header Authorization "Bearer $cookie_collab_token";
        }

        location / {
            auth_request /_auth;
            proxy_pass http://collab_backend;

            proxy_http_version 1.1;
            proxy_set_header Upgrade    $http_upgrade;
            proxy_set_header Connection $connection_upgrade;
            proxy_set_header Host       $host;
            proxy_set_header X-Real-IP  $remote_addr;
            proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;

            # WebSockets de larga duración — no cortar la conexión
            proxy_read_timeout    3600s;
            proxy_send_timeout    3600s;
            proxy_connect_timeout    10s;

            # Buffer desactivado para mensajes en tiempo real
            proxy_buffering off;

            proxy_next_upstream error timeout;
        }
    }
}